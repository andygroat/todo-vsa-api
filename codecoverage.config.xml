<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <CodeCoverage>

    <!-- Exclude anything decorated with these attributes (covers Roslyn/OpenAPI/EF generated code) -->
    <Attributes>
      <Exclude>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
      </Exclude>
    </Attributes>
  </CodeCoverage>
</Configuration>